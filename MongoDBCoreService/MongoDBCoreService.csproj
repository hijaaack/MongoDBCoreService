<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AssemblyName>MongoDBCoreService</AssemblyName>
	</PropertyGroup>

	<PropertyGroup>
		<Company>Jack Borelius</Company>
		<Description>Generic (.NET8) MongoDB Service for TwinCAT HMI</Description>
		<Copyright>Copyright © hijaaack 2026</Copyright>
	</PropertyGroup>

	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<PropertyGroup>
		<TcHmiExtensionTypes>{165402F8-2FAD-480A-BCE3-D718A6135931}</TcHmiExtensionTypes>
	</PropertyGroup>

	<PropertyGroup>
		<TcHmiServerApiVersionNumberMajor>2</TcHmiServerApiVersionNumberMajor>
	</PropertyGroup>

	<PropertyGroup>
		<TcHmiInstallDir>$(registry:HKEY_CURRENT_USER\Software\Beckhoff\TwinCAT3\3.1@InstallDir)</TcHmiInstallDir>
		<TcHmiInstallDir Condition="'$(TcHmiInstallDir)'==''">$(registry:HKEY_LOCAL_MACHINE\Software\Beckhoff\TwinCAT3\3.1@InstallDir)</TcHmiInstallDir>
		<TcHmiInstallDir Condition="'$(TcHmiInstallDir)'==''">$(registry:HKEY_LOCAL_MACHINE\Software\Wow6432Node\Beckhoff\TwinCAT3\3.1@InstallDir)</TcHmiInstallDir>
		<TcHmiEgineeringDir>$(TcHmiInstallDir)..\Functions\TE2000-HMI-Engineering</TcHmiEgineeringDir>
		<TcHmiMsBuildPath Condition="'$(TcHmiMsBuildPath)' == ''">$(TcHmiEgineeringDir)\MSBuild\</TcHmiMsBuildPath>
	</PropertyGroup>

	<PropertyGroup>
		<DefaultItemExcludes>$(DefaultItemExcludes);___initialBuild_of_this_extension.tmp</DefaultItemExcludes>
	</PropertyGroup>

	<PropertyGroup>
		<ProjectGuid>9be100bb-7c66-498c-b978-78c86c4e7b7d</ProjectGuid>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageIcon>Images\logo.png</PackageIcon>
		<PackageProjectUrl>https://github.com/hijaaack/MongoDBCoreService</PackageProjectUrl>
		<Title>MongoDBCoreService</Title>
		<Version>1.3.0</Version>
		<Authors>Jack Borelius</Authors>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/hijaaack/MongoDBCoreService</RepositoryUrl>
		<PackageReleaseNotes>Changed from .NET Core 3.1 to .NET8. Added method UpdateDocuments for bulk changes.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Beckhoff.TwinCAT.HMI.TcHmiSrvExtNet.Core.SDK" Version="3.0.7983" />
	  <PackageReference Include="MongoDB.Driver" Version="3.8.1" />
	  <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	  <PackageReference Include="SharpCompress" Version="0.48.0" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Images\logo.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </None>
	  <None Update="LICENSE.txt">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>